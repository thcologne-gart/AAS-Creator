<?xml version="1.0" encoding="UTF-8"?><xs:schema  xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:aas="https://admin-shell.io/aas/3/0" xmlns:IEC61360="https://admin-shell.io/IEC61360/3/0"  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:n1="TGA_Profil" targetNamespace="TGA_Profil" elementFormDefault="qualified" attributeFormDefault="qualified" xmlns:n2="Header">	<xs:import namespace="https://admin-shell.io/aas/3/0" schemaLocation="AAS_V3.0.7.xsd"/>	<xs:import namespace="http://www.admin-shell.io/IEC61360/3/0" schemaLocation="IEC61360.xsd"/>	<!--Substitute aasenv by TGA-Profil-->	<xs:element name="aasenv" type="xs:string"/>	<xs:element name="TGA-Profil" substitutionGroup="aas:environment" xmlns:n1="https://admin-shell.io/aas/3/0"/>	<xs:group name="TGA-Profil">		<xs:sequence>			<xs:element name="Description" minOccurs="1">				<xs:complexType>					<xs:simpleContent>						<xs:extension base="xs:string"/>					</xs:simpleContent>				</xs:complexType>			</xs:element>			<xs:element name="Version" minOccurs="1">				<xs:complexType>					<xs:simpleContent>						<xs:extension base="xs:string"/>					</xs:simpleContent>				</xs:complexType>			</xs:element>			<xs:element name="Revision" minOccurs="1" maxOccurs="unbounded">				<xs:complexType>					<xs:sequence>						<xs:element name="RevisionDate" type="xs:dateTime"/>						<xs:element name="OldVersion" type="xs:string" minOccurs="1"/>						<xs:element name="NewVersion" type="xs:string" minOccurs="1"/>						<xs:element name="AuthorName" type="xs:string"/>						<xs:element name="Comment" type="xs:string" minOccurs="1"/>					</xs:sequence>				</xs:complexType>			</xs:element>			<xs:element name="Copyright" minOccurs="1">				<xs:complexType>					<xs:simpleContent>						<xs:extension base="xs:string"/>					</xs:simpleContent>				</xs:complexType>			</xs:element>			<xs:element name="AdditionalInformation" minOccurs="0" maxOccurs="unbounded">				<xs:complexType>					<xs:attribute name="title" type="xs:string" use="required"/>					<xs:attribute name="content" type="xs:string" use="optional"/>				</xs:complexType>			</xs:element>		</xs:sequence>	</xs:group>	<!--	<xs:complexType name="TGA-Profil" xml:base="aas:aasenv">		<xs:sequence minOccurs="1" maxOccurs="unbounded" xsi:schemaLocation="assetAdministrationShells" xml:base="aas:assetAdministrationShells_t"/>	</xs:complexType>--></xs:schema>